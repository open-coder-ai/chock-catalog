{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.chock-hook=!sh .chock/bin/launch.sh\" chock-hook .chock/bin/gemini_cli.py --gate \".chock/compiled/scan-secrets/pre-tool-use/gate.json\""
          }
        ],
        "matcher": "write_file|replace"
      }
    ]
  }
}