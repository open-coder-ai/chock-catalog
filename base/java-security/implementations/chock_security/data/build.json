{
  "insecure_repository": {
    "maven_block_open": {
      "repository": "<repository>",
      "pluginRepository": "<pluginRepository>",
      "mirror": "<mirror>",
      "distributionManagement": "<distributionManagement>"
    },
    "maven_url_marker": "<url>",
    "scheme": "http://",
    "safe_hosts": [
      "http://localhost",
      "http://127.0.0.1"
    ],
    "gradle_block_marker": "maven",
    "gradle_flags": [
      "allowInsecureProtocol = true",
      "isAllowInsecureProtocol = true"
    ],
    "wrapper_key": "distributionUrl="
  },
  "checksum_disabled": {
    "maven_disabled": "<checksumPolicy>ignore</checksumPolicy>",
    "gradle_key": "org.gradle.dependency.verification",
    "gradle_disabled_value": "off"
  },
  "dynamic_version": {
    "gradle_markers": [
      "latest.release",
      "latest.integration"
    ],
    "maven_tokens": [
      "LATEST",
      "RELEASE"
    ]
  },
