{
  "log4j_lookups": {
    "markers": ["log4j2.formatMsgNoLookups=false", "%m{lookups}", "%msg{lookups}", "${jndi:"]
  },
  "logger_calls": {
    "sinks": ["log.trace(", "log.debug(", "log.info(", "log.warn(", "log.error(",
              "logger.trace(", "logger.debug(", "logger.info(", "logger.warn(", "logger.error(",
              "LOG.trace(", "LOG.debug(", "LOG.info(", "LOG.warn(", "LOG.error(",
              "LOGGER.trace(", "LOGGER.debug(", "LOGGER.info(", "LOGGER.warn(", "LOGGER.error("]
  },
  "sensitive_data": {
    "names": ["password", "passwd", "pwd", "secret", "token", "apikey", "api_key", "accesstoken",
              "refreshtoken", "privatekey", "creditcard", "cardnumber", "cvv", "ssn"],
    "masked_markers": ["mask(", "redact(", "****"]
  },
  "stacktrace_response": {
    "writer_call": "getWriter()"
  }
}
