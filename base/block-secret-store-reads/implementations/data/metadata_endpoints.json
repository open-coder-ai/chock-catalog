{
  "schema": 1,
  "kind": "curated",
  "as_of": "2026-10-10",
  "source": "Instance metadata docs: AWS EC2 (docs.aws.amazon.com/AWSEC2/latest/UserGuide/instancedata-data-retrieval.html), Amazon ECS task IAM roles and task metadata v4, Google Compute Engine (cloud.google.com/compute/docs/metadata/querying-metadata), Azure IMDS (learn.microsoft.com/azure/virtual-machines/instance-metadata-service), OCI (docs.oracle.com/iaas/Content/Compute/Tasks/gettingmetadata.htm)",
  "endpoints": [
    {
      "id": "imds",
      "label": "the cloud instance metadata service (169.254.169.254)",
      "hosts": ["169.254.169.254"],
      "allow": [
        "/latest/api/token",
        "/(latest|[0-9]{4}-[0-9]{2}-[0-9]{2})/meta-data/(placement/(region|availability-zone|availability-zone-id)|instance-id|instance-type|ami-id|hostname|local-hostname|local-ipv4)",
        "/(latest|[0-9]{4}-[0-9]{2}-[0-9]{2})/dynamic/instance-identity/document",
        "/computeMetadata/v1/(instance/(zone|id|name|hostname|machine-type)|project/(project-id|numeric-project-id))",
        "/metadata/instance/compute/(location|zone|vmSize|vmId|name|resourceGroupName|osType)",
        "/opc/v[12]/instance/(region|canonicalRegionName|availabilityDomain|id|shape|displayName)"
      ]
    },
    {
      "id": "imds-ipv6",
      "label": "the AWS instance metadata service over IPv6 (fd00:ec2::254)",
      "hosts": ["fd00:ec2::254"],
      "allow": [
        "/latest/api/token",
        "/(latest|[0-9]{4}-[0-9]{2}-[0-9]{2})/meta-data/(placement/(region|availability-zone|availability-zone-id)|instance-id|instance-type|ami-id|hostname|local-hostname|local-ipv4)",
        "/(latest|[0-9]{4}-[0-9]{2}-[0-9]{2})/dynamic/instance-identity/document"
      ]
    },
    {
      "id": "gce",
      "label": "the Google Compute Engine metadata server (metadata.google.internal)",
      "hosts": ["metadata.google.internal"],
      "allow": [
        "/computeMetadata/v1/(instance/(zone|id|name|hostname|machine-type)|project/(project-id|numeric-project-id))"
      ]
    },
    {
      "id": "ecs",
      "label": "the Amazon ECS task credential endpoint (169.254.170.2)",
      "hosts": ["169.254.170.2"],
      "allow": [
        "/v2/(metadata|stats)",
        "/v[34]/[A-Za-z0-9-]+(/(task|stats|taskWithTags|task/stats))?"
      ]
    }
  ],
  "variables": ["AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "AWS_CONTAINER_CREDENTIALS_FULL_URI"],
  "fetchers": [
    "curl", "wget", "wget2", "http", "https", "xh", "xhs", "curlie", "aria2c", "lwp-request", "fetch",
    "invoke-webrequest", "iwr", "invoke-restmethod", "irm"
  ],
  "sockets": ["nc", "ncat", "netcat", "telnet"]
}
