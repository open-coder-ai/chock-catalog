{
  "schema": 1,
  "kind": "curated",
  "as_of": "2026-10-02",
  "source": "Security coverage roadmap NP28 (credential stores, readers and token printers) and the s1ngularity and Shai-Hulud incident reports",
  "home": [
    {"id": "ssh", "label": "SSH keys and config (~/.ssh)", "paths": [".ssh"], "allow": ["*.pub"], "relative": "always"},
    {"id": "aws", "label": "AWS credentials (~/.aws)", "paths": [".aws"], "relative": "always"},
    {"id": "gnupg", "label": "GnuPG keyrings (~/.gnupg)", "paths": [".gnupg"], "relative": "always"},
    {"id": "gh", "label": "GitHub CLI tokens (~/.config/gh)", "paths": [".config/gh"], "relative": "code"},
    {"id": "npmrc", "label": "the npm auth file (~/.npmrc)", "paths": [".npmrc"], "relative": "code"},
    {"id": "pypirc", "label": "the PyPI auth file (~/.pypirc)", "paths": [".pypirc"], "relative": "code"},
    {"id": "netrc", "label": "the netrc credentials file (~/.netrc)", "paths": [".netrc"], "relative": "code"},
    {"id": "docker", "label": "Docker registry auth (~/.docker/config.json)", "paths": [".docker/config.json"], "relative": "code"},
    {"id": "kube", "label": "the kubeconfig (~/.kube/config)", "paths": [".kube/config"], "relative": "code"},
    {"id": "agent", "label": "an agent CLI's credentials and settings (~/.claude*, ~/.codex, ~/.cursor, ~/.gemini)", "paths": [".claude*", ".codex", ".cursor", ".gemini"]},
    {"id": "cloud", "label": "a cloud or vault credential store", "paths": [".azure", ".config/gcloud", ".oci", ".config/doctl", ".config/op", ".vault-token", ".password-store", "Library/Keychains"]},
    {"id": "registry", "label": "a package or Terraform registry credential file", "paths": [".terraform.d/credentials.tfrc.json", ".cargo/credentials*", ".gem/credentials"]},
    {
      "id": "browser",
      "label": "a browser profile database (logins, cookies, key store)",
      "files": ["Login Data", "Login Data For Account", "Cookies", "Web Data", "Local State", "key3.db", "key4.db", "logins.json", "cookies.sqlite"],
      "paths": [
        ".config/google-chrome", ".config/chromium", ".config/BraveSoftware", ".config/microsoft-edge",
        ".mozilla", "snap/firefox/common/.mozilla", "snap/chromium/common/chromium",
        ".var/app/org.mozilla.firefox", ".var/app/com.google.Chrome", ".var/app/org.chromium.Chromium",
        ".var/app/com.brave.Browser", ".var/app/com.microsoft.Edge",
        "Library/Application Support/Google/Chrome", "Library/Application Support/Chromium",
        "Library/Application Support/Firefox", "Library/Application Support/BraveSoftware",
        "Library/Application Support/Microsoft Edge",
        "AppData/Local/Google/Chrome", "AppData/Local/Chromium", "AppData/Roaming/Mozilla",
        "AppData/Local/BraveSoftware", "AppData/Local/Microsoft/Edge"
      ]
    },
    {
      "id": "wallet",
      "label": "a cryptocurrency wallet directory",
      "paths": [
        ".bitcoin", ".ethereum", ".electrum", ".litecoin", ".dogecoin", ".monero", ".config/Exodus", ".config/Electrum",
        "Library/Application Support/Exodus", "Library/Application Support/Bitcoin", "Library/Application Support/Electrum",
        "AppData/Roaming/Exodus", "AppData/Roaming/Bitcoin", "AppData/Roaming/Electrum"
      ]
    }
  ],
  "names": [
    {"id": "env", "label": "an environment file (.env)", "patterns": [".env", ".env.*"]},
    {"id": "tfstate", "label": "Terraform state (*.tfstate)", "patterns": ["*.tfstate", "*.tfstate.*"]},
    {"id": "key", "label": "an SSH private key", "patterns": ["id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", "id_ecdsa_sk", "id_ed25519_sk"]},
    {"id": "credfile", "label": "a credentials file", "patterns": [".netrc", "_netrc", ".pgpass", ".git-credentials", ".pypirc", "credentials.tfrc.json"]}
  ],
  "templates": [".example", ".sample", ".template", ".dist"],
  "absolute": [
    {"id": "environ", "label": "a process environment (/proc/*/environ)", "path": "/proc/*/environ", "action": "ask"}
  ],
  "interpreters": ["python", "node", "nodejs", "ruby", "perl", "php", "deno", "bun", "lua"],
  "recursive": {
    "tar": true, "bsdtar": true, "zip": true, "7z": true, "7za": true, "cp": true, "mv": true, "rsync": true, "scp": true,
    "grep": ["-r", "-R", "--recursive", "--dereference-recursive"], "egrep": ["-r", "-R", "--recursive"],
    "fgrep": ["-r", "-R", "--recursive"], "rg": ["--hidden", "-.", "-u", "--unrestricted"], "ag": ["--hidden", "-u", "--unrestricted"]
  },
  "readers": {
    "cat": "operands", "tac": "operands", "nl": "operands", "less": "operands", "more": "operands", "bat": "operands",
    "batcat": "operands", "head": "operands", "tail": "operands", "strings": "operands", "xxd": "operands",
    "hexdump": "operands", "hd": "operands", "od": "operands", "base64": "operands", "base32": "operands",
    "cut": "operands", "sort": "operands", "uniq": "operands", "paste": "operands", "column": "operands",
    "fold": "operands", "rev": "operands", "diff": "operands", "gzip": "operands", "zcat": "operands",
    "bzip2": "operands", "bzcat": "operands", "xz": "operands", "xzcat": "operands", "openssl": "operands",
    "gpg": "operands", "gpg2": "operands", "source": "operands", ".": "operands", "get-content": "operands",
    "gc": "operands", "type": "operands", "select-string": "operands", "sls": "operands",
    "grep": "pattern-first", "egrep": "pattern-first", "fgrep": "pattern-first", "rg": "pattern-first",
    "ag": "pattern-first", "ack": "pattern-first", "jq": "pattern-first", "yq": "pattern-first",
    "sed": "program-first", "awk": "program-first", "gawk": "program-first", "mawk": "program-first",
    "cp": "sources", "mv": "sources", "rsync": "sources", "scp": "sources", "install": "sources", "ln": "sources",
    "copy-item": "sources", "copy": "sources", "cpi": "sources",
    "tar": "archive", "bsdtar": "archive", "zip": "archive", "7z": "archive", "7za": "archive",
    "dd": "dd"
  },
  "printers": [
    {"id": "gh-auth-token", "what": "gh auth token", "cmd": "gh", "words": ["auth", "token"], "value_flags": ["-R", "--repo", "--hostname"]},
    {"id": "gh-show-token", "what": "gh auth status --show-token", "cmd": "gh", "words": ["auth", "status"], "flags": ["-t", "--show-token"], "value_flags": ["-R", "--repo", "--hostname"]},
    {"id": "aws-get", "what": "aws configure get of a secret field", "cmd": "aws", "words": ["configure", "get"], "field": "secret|key|token|password|session", "value_flags": ["--profile", "--region", "--endpoint-url", "--output", "--query", "--ca-bundle", "--color"]},
    {"id": "aws-export", "what": "aws configure export-credentials", "cmd": "aws", "words": ["configure", "export-credentials"], "value_flags": ["--profile", "--region", "--endpoint-url", "--output", "--query", "--ca-bundle", "--color"]},
    {"id": "aws-session", "what": "aws sts get-session-token", "cmd": "aws", "words": ["sts", "get-session-token"], "value_flags": ["--profile", "--region", "--endpoint-url", "--output", "--query", "--ca-bundle", "--color"]},
    {"id": "kubectl-raw", "what": "kubectl config view --raw", "cmd": "kubectl", "words": ["config", "view"], "flags": ["--raw", "--flatten"], "value_flags": ["-n", "--namespace", "--context", "--cluster", "--user", "--kubeconfig", "--server", "-s"]},
    {"id": "keychain-generic", "what": "security find-generic-password with -w or -g", "cmd": "security", "words": ["find-generic-password"], "flags": ["-w", "-g"], "value_flags": ["-a", "-s", "-l", "-D", "-j", "-c", "-C", "-r"]},
    {"id": "keychain-internet", "what": "security find-internet-password with -w or -g", "cmd": "security", "words": ["find-internet-password"], "flags": ["-w", "-g"], "value_flags": ["-a", "-s", "-l", "-D", "-j", "-c", "-C", "-r", "-d", "-p", "-P", "-t"]},
    {"id": "gpg-secret", "what": "gpg --export-secret-keys", "cmd": "gpg*", "words": [], "flags": ["--export-secret-keys", "--export-secret-subkeys"]},
    {"id": "git-fill", "what": "git credential fill", "cmd": "git", "words": ["credential", "fill"], "value_flags": ["-c", "-C", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--config-env"]},
    {"id": "git-helper", "what": "a git credential helper get", "cmd": "git-credential-*", "words": ["get"], "value_flags": ["--file"]},
    {"id": "docker-helper", "what": "a docker credential helper get", "cmd": "docker-credential-*", "words": ["get"]}
  ]
}
