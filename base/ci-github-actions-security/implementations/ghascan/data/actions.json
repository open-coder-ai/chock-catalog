    "google-github-actions/run-gemini-cli",
    "openai/codex-action",
    "actions/ai-inference"
  ],
  "cache_actions": [
    "actions/cache",
    "swatinem/rust-cache",
    "mozilla-actions/sccache-action",
    "hendrikmuhs/ccache-action",
    "gradle/actions/setup-gradle",
    "gradle/gradle-build-action"
