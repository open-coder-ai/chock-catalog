    "zizmor-audits": "https://docs.zizmor.sh/audits/",
    "actionlint-checks": "https://github.com/rhysd/actionlint/blob/main/docs/checks.md",
    "gh-secure-use": "https://docs.github.com/en/actions/reference/security/secure-use",
