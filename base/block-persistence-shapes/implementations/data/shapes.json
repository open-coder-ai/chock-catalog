  "rules": [
    {
      "prog": [
        "npm",
        "pnpm",
        "yarn",
        "bun"
      ],
      "level": "block",
      "verbs": [
        [
          "publish"
        ],
        [
          "npm",
          "publish"
        ]
      ],
      "dry_run": true,
      "why": "publishes a package to a registry; run `npm pack` or `npm publish --dry-run` to inspect what would ship, and let the person publish"
    },
    {
      "prog": [
        "npm",
        "pnpm"
      ],
      "level": "block",
      "verbs": [
        [
          "login"
        ],
        [
          "adduser"
        ],
        [
          "add-user"
        ]
      ],
      "why": "stores registry credentials that outlive the session"
    },
    {
      "prog": [
        "npm",
        "yarn"
      ],
      "level": "block",
      "verbs": [
        [
          "token",
          "create"
        ],
        [
          "npm",
          "token",
          "create"
        ]
      ],
      "why": "mints a registry token that outlives the session"
    },
    {
      "prog": [
        "npm",
        "pnpm",
        "yarn"
      ],
      "level": "block",
      "verbs": [
        [
          "config",
          "set"
        ],
        [
          "set"
        ]
      ],
      "config_key": "(?i)(_auth|_password|registry|npmauthtoken)",
      "why": "changes the registry or its credentials, which redirects later publishes and installs"
    },
    {
      "prog": [
        "twine"
      ],
      "level": "block",
      "verbs": [
        [
          "upload"
        ]
      ],
      "why": "uploads distributions to a package index; build with `python -m build` and let the person upload"
    },
    {
      "prog": [
        "poetry",
        "uv"
      ],
      "level": "block",
      "verbs": [
        [
          "publish"
        ]
      ],
      "dry_run": true,
      "why": "publishes a package to an index; use --dry-run, and let the person publish"
    },
    {
      "prog": [
        "cargo"
      ],
      "level": "block",
      "verbs": [
        [
          "publish"
        ]
      ],
      "dry_run": true,
      "why": "publishes a crate; use `cargo publish --dry-run` or `cargo package`, and let the person publish"
    },
    {
      "prog": [
        "gem"
      ],
      "level": "block",
      "verbs": [
        [
          "push"
        ]
      ],
      "why": "pushes a gem to a registry; run `gem build` and let the person push"
    },
    {
      "prog": [
        "docker",
        "podman",
        "docker-compose",
        "podman-compose"
      ],
      "level": "block",
      "verbs": [
        [
          "push"
        ],
        [
          "image",
          "push"
        ],
        [
          "manifest",
          "push"
        ],
        [
          "compose",
          "push"
        ],
        [
          "login"
        ]
      ],
      "why": "pushes an image or stores registry credentials; run `docker build` locally and let the person push or log in"
    },
    {
      "prog": [
        "gh"
      ],
      "level": "ask",
      "verbs": [
        [
          "release",
          "create"
        ]
      ],
      "why": "creates a public release"
    },
    {
      "prog": [
        "gh"
      ],
      "level": "block",
      "verbs": [
        [
          "repo",
          "create"
        ],
        [
          "repo",
          "edit"
        ]
      ],
      "when": {
        "flags": [
          "--public"
        ],
        "values": {
          "--visibility": [
            "public"
          ]
        }
      },
      "why": "makes a repository public; create it private and let the person change the visibility"
    },
    {
      "prog": [
        "gh"
      ],
      "level": "block",
      "verbs": [
        [
          "api"
        ]
      ],
      "when": {
        "arg_regex": "(?i)^(?:--[a-z-]+=)?(private=false|visibility=public)$"
      },
      "why": "makes a repository public through the API; let the person change the visibility"
    },
    {
      "prog": [
        "systemctl"
      ],
      "level": "block",
      "verbs": [
        [
          "enable"
        ],
        [
          "reenable"
        ],
        [
          "start"
        ],
        [
          "link"
        ]
      ],
      "when": {
        "flags": [
          "--user"
        ]
      },
      "why": "installs or starts a user service that survives the session; run the program directly instead"
    },
    {
      "prog": [
        "loginctl"
      ],
      "level": "block",
      "verbs": [
        [
          "enable-linger"
        ]
      ],
      "why": "lets user services run after logout"
    },
    {
      "prog": [
        "launchctl"
      ],
      "level": "block",
      "verbs": [
        [
          "load"
        ],
        [
          "bootstrap"
        ],
        [
          "submit"
        ],
        [
          "enable"
        ]
      ],
      "why": "loads a launch job that survives the session; run the program directly instead"
    },
    {
      "prog": [
        "crontab"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "unless": [
        "-l"
      ],
      "why": "installs or edits a scheduled job; `crontab -l` only lists"
    },
    {
      "prog": [
        "at",
        "batch"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "unless": [
        "-l",
        "-c"
      ],
      "why": "schedules a deferred job; `at -l` only lists"
    },
    {
      "prog": [
        "schtasks"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "why": "registers a scheduled task that survives the session",
      "when": {
        "arg_regex": "(?i)^[-/]create$"
      }
    },
    {
      "prog": [
        "register-scheduledtask",
        "register-scheduledjob"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "why": "registers a scheduled task that survives the session"
    },
    {
      "prog": [
        "reg"
      ],
      "level": "block",
      "verbs": [
        [
          "add"
        ]
      ],
      "when": {
        "arg_regex": "(?i)(currentversion/(run|runonce|runonceex|runservices|runservicesonce)(/|$)|policies/explorer/run(/|$))"
      },
      "why": "writes a Windows Run key that starts a program at every logon"
    },
    {
      "prog": [
        "new-itemproperty",
        "set-itemproperty",
        "sp"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "when": {
        "arg_regex": "(?i)(currentversion/(run|runonce|runonceex|runservices|runservicesonce)(/|$)|policies/explorer/run(/|$))"
      },
      "why": "writes a Windows Run key that starts a program at every logon"
    },
    {
      "prog": [
        "config.sh",
        "config.cmd"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "when": {
        "flags": [
          "--url",
          "--token"
        ]
      },
      "why": "registers a self-hosted CI runner that keeps taking jobs after the session"
    },
    {
      "prog": [
        "svc.sh",
        "svc.cmd"
      ],
      "level": "block",
      "verbs": [
        [
          "install"
        ],
        [
          "start"
        ]
      ],
      "why": "installs or starts a CI runner service that survives the session"
    },
    {
      "prog": [
        "visudo"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "unless": [
        "-c"
      ],
      "why": "edits sudo rules; `visudo -c` only checks them"
    },
    {
      "prog": [
        "sudoedit"
      ],
      "level": "block",
      "verbs": [
        []
      ],
      "when": {
        "arg_regex": "(?i)(^|/)etc/sudoers"
      },
      "why": "edits sudo rules"
    }
  ],
  "file_paths": [
    "\\.ssh/authorized_keys2?$",
    "^authorized_keys2?$",
    "^\\$[^/]*/(.*/)?authorized_keys2?$"
  ],
  "dir_paths": [
    "(^|/)\\.config/systemd/user(/|$)",
    "^(/private)?/(usr/)?(etc|lib)/systemd/(system|user)(/|$)",
    "(^|/)library/launch(agents|daemons)(/|$)",
    "^(/private)?/etc/(cron\\.(d|daily|hourly|weekly|monthly|allow|deny)|crontab|anacrontab)(/|$)",
    "^(/private)?/var/spool/cron(/|$)",
    "^(/private)?/etc/sudoers($|\\.d(/|$))",
    "^\\$[^/]*/(.*/)?systemd/user(/|$)"
  ],
  "write_exempt": [
    "chmod",
    "chown",
    "chgrp",
    "touch",
    "rm",
    "unlink",
    "rmdir",
    "shred",
    "del",
    "erase",
    "rd",
    "remove-item",
    "ri"
  ],
  "setid_symbolic": "^[ugoa]*[+=][rwxXt]*s[rwxXt]*$",
  "setid_numeric": "^0*[2-7][0-7]{3}$",
  "url_arg": "(?i)^(?:[a-z][a-z0-9+.-]*://|[^@\\s/]+@[^:\\s/]+:|[a-z0-9-]+(?:\\.[a-z0-9-]+)+:)",
  "downloaders": [
    "curl",
    "wget",
    "aria2c",
    "iwr",
    "irm",
    "invoke-webrequest",
    "invoke-restmethod",
    "start-bitstransfer"
  ],
  "detachers": [
    "nohup",
    "setsid"
  ],
  "iocs": [
    "gh-token-monitor"
  ],
  "runners": {
    "npm": [
      "exec",
      "x"
    ],
    "pnpm": [
      "exec",
      "dlx"
    ],
    "yarn": [
      "exec",
      "dlx"
    ],
    "bun": [
      "x"
    ],
    "uv": [
      "run",
      "tool run"
    ],
    "poetry": [
      "run"
    ],
    "pipx": [
      "run"
    ],
    "bundle": [
      "exec"
    ]
  }
}
