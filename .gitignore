# the framework, checked out by CI to install it from a private repo
.framework/

# This repo is an adopter, so `.agents/` and `.chock/` are committed, not ignored:
# they are the policies it is governed by and the artifacts `recompile --check` verifies.
# What is ignored is what a tool regenerates from them.

# Skills bridge is generated by `chock sync` — .agents/skills is the source of truth
.claude/skills/

# Skill schemas are injected by `chock install-skills`
.agents/skills/**/assets/manifest*.json

__pycache__/

# Coverage data `pytest --cov` writes on every run (committed once by accident)
.coverage
.coverage.*

# Editor and IDE local state (an .iml file was committed once already)
.idea/
*.iml
.vscode/
.DS_Store

# Local gate-outcome evidence log (written by the PreToolUse gate at run time)
.chock/log/
# chock: the gate runtime and compiled gates are what every hook runs -- tracked even where
# a global rule (a `bin/` from a Visual Studio or Java template) would ignore them
!.chock/bin/
!.chock/bin/**
!.chock/compiled/
!.chock/compiled/**
# chock: installed policies are tracked whole -- a policy's `build/` sub-package must reach every
# clone, whatever a `build/`, `out/` or `target/` rule elsewhere says
!.agents/policies/
!.agents/policies/**
# chock: bytecode under the policies is per machine (must stay after the rules above)
.agents/policies/**/__pycache__/
.agents/policies/**/*.pyc
# chock: the per-session tool-call log is per machine and never shared
.chock/state/
# chock: bytecode under the runtime and compiled gates is per machine (must stay after the rules above)
.chock/bin/**/__pycache__/
.chock/bin/**/*.pyc
.chock/compiled/**/__pycache__/
.chock/compiled/**/*.pyc
