# the framework, checked out by CI to install it from a private repo
.framework/

# This repo is an adopter, so `.agents/` and `.chock/` are committed, not ignored:
# they are the policies it is governed by and the artifacts `recompile --check` verifies.
# What is ignored is what a tool regenerates from them.

# Skills bridge is generated by `chock sync` — .agents/skills is the source of truth
.claude/skills/

# Skill schemas are injected by `chock install-skills`
.agents/skills/**/assets/manifest*.json

__pycache__/

# Editor and IDE local state (an .iml file was committed once already)
.idea/
*.iml
.vscode/
.DS_Store

# Local gate-outcome evidence log (written by the PreToolUse gate at run time)
.chock/log/
