{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A promotion record: what a policy did over real history, and over its own eval cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "version", "engine", "catalog", "date", "corpora", "triage", "eval", "misses", "correct_work_rate", "bar_met"],
  "properties": {
    "policy": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "engine": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "catalog": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "commits", "history_exhausted", "judged", "fires"],
        "properties": {
          "repo": {"type": "string", "minLength": 1},
          "commits": {"type": "integer", "minimum": 0},
          "history_exhausted": {"description": "The whole first-parent history was replayed: it ran out before the limit.", "type": "boolean"},
          "judged": {"type": "integer", "minimum": 0},
          "fires": {"type": "integer", "minimum": 0}
        }
      }
    },
    "triage": {
      "description": "One entry per fire (a commit the gate refused). An empty verdict is a fire not yet judged.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "commit", "path", "rule", "verdict", "reason"],
        "properties": {
          "repo": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {"type": "string"},
          "rule": {"type": "string"},
          "verdict": {"enum": ["", "correct_work", "true_catch"]},
          "reason": {"type": "string"}
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "allow"],
      "properties": {
        "block": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caught", "total"],
          "properties": {"caught": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}
        },
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "total"],
          "properties": {"allowed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "misses": {
      "description": "`read`: a person read the policy's own Misses sentence. `listed`: the items that sentence names (0 when it has none).",
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "listed"],
      "properties": {"read": {"type": "boolean"}, "listed": {"type": "integer", "minimum": 0}}
    },
    "correct_work_rate": {"description": "correct_work fires divided by commits judged over every corpus; null until every fire is judged.", "type": ["number", "null"], "minimum": 0, "maximum": 1},
    "bar_met": {"type": "boolean"}
  }
}
